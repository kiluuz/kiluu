generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  username         String    @unique
  password         String
  displayName      String?
  role             String    @default("user") // user | creator | admin (legacy: VIEWER | CREATOR | ADMIN)
  avatarUrl        String?
  bannerUrl        String?
  bio              String?
  accentColor      String    @default("#f97316")
  credits          Int       @default(0)
  onboardingDone   Boolean   @default(false)
  favoriteGenres   String    @default("")
  telegramId       String?   @unique
  telegramUsername String?
  locale           String    @default("uz")
  lastSeenAt       DateTime?
  communityBlocked Boolean   @default(false)
  emailVerified    Boolean   @default(false)
  verifyCode       String?
  verifyCodeExp    DateTime?
  deletedAt        DateTime? // set when the account is anonymized by the mobile bridge
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ---- Discord-level customization ----
  pronouns              String? // e.g. "they/them"
  tagline               String? // short one-liner under name
  country               String? // ISO country code
  timezone              String? // IANA tz e.g. "Asia/Tashkent"
  socialLinks           String? // JSON {telegram, instagram, youtube, x}
  statusEmoji           String? // custom status emoji
  statusText            String? // custom status text
  accentTo              String? // gradient end color (accentColor is "from")
  avatarFrame           String? // none | gold | ember | neon | sakura (unlockable)
  equippedAvatarFrameId String? @map("equipped_avatar_frame_id")
  equippedNameFrameId   String? @map("equipped_name_frame_id")
  bannerPreset          String? // preset banner id when using gallery
  showcase              String? // JSON {topFive:[], pinnedPostId, genres:[], achievementIds:[], order:[], hidden:{}}
  privacy               String? // JSON {showWatchTime, showFavorites, showActivity, allowFollows, profileVisibility}

  sessions             Session[]
  telegramLinkTokens   TelegramLinkToken[]
  createdVersions      AnimeVersion[]         @relation("VersionCreator")
  purchases            Purchase[]
  orders               Order[] // Telegram Bot Purchases
  favoriteAnimes       FavoriteAnime[]
  favoriteUsersFrom    FavoriteUser[]         @relation("Favoriter")
  favoriteUsersTo      FavoriteUser[]         @relation("Favorited")
  following            Follow[]               @relation("FollowSource")
  followers            Follow[]               @relation("FollowTarget")
  posts                Post[]
  postLikes            PostLike[]
  comments             Comment[]
  watchProgress        WatchProgress[]
  creditTransactions   CreditTransaction[]
  exchangeOffers       ExchangeOffer[]
  proposalsMade        ExchangeProposal[]     @relation("Proposer")
  createdAnimes        Anime[]                @relation("AnimeCreator")
  dubJobs              DubJob[]
  notifySubscriptions  AnimeNotify[]
  xpEvents             XpEvent[]
  userAchievements     UserAchievement[]
  giftsSent            Gift[]                 @relation("GiftSender")
  giftsReceived        Gift[]                 @relation("GiftRecipient")
  notifications        Notification[]
  postBookmarks        PostBookmark[]
  postAwardsGiven      PostAward[]
  reportsFiled         Report[]               @relation("Reporter")
  commentsLiked        CommentLike[]
  scheduleSubs         ScheduleSubscription[]
  scheduleDeliveries   ScheduleDelivery[]
  dubWaitlist          DubWaitlist[]
  watchPartiesHosted   WatchParty[]           @relation("PartyHost")
  watchPartiesCreated  WatchParty[]           @relation("PartyCreator")
  watchPartyMembers    WatchPartyMember[]
  watchPartyMessages   WatchPartyMessage[]
  creditPackagesPaid   StarsPayment[]
  donationIntents      DonationIntent[]         @relation("DonationIntentUser")
  payoutRequests       PayoutRequest[]          @relation("PayoutUser")
  payoutsProcessed     PayoutRequest[]          @relation("PayoutAdmin")
  animeRatings         AnimeRating[]
  watchEvents          WatchEvent[]
  // 10-QISM
  clubsOwned           Club[]                 @relation("ClubOwner")
  clubMemberships      ClubMember[]
  clubJoinRequests     ClubJoinRequest[]
  chatMessages         ChatMessage[]
  messageReactions     MessageReaction[]
  pollVotes            PollVote[]
  chatBans             ChatBan[]
  blockedBy            UserBlock[]            @relation("Blocker")
  blockedUsers         UserBlock[]            @relation("Blocked")
  userEmotes           UserEmote[]
  equippedAvatarFrame  Frame?                 @relation("EquippedAvatarFrame", fields: [equippedAvatarFrameId], references: [id], onDelete: SetNull)
  equippedNameFrame    Frame?                 @relation("EquippedNameFrame", fields: [equippedNameFrameId], references: [id], onDelete: SetNull)
  frames               UserFrame[]
  dubTeamsOwned        DubTeam[]              @relation("DubTeamOwner")
  dubTeamMemberships   DubTeamMember[]        @relation("DubTeamMemberUser")
  dubTeamRatings       DubTeamRating[]        @relation("DubTeamRatingUser")
  dubTeamInvites       DubTeamInvite[]        @relation("DubTeamInviteUser")
  dubTeamInvitesSent   DubTeamInvite[]        @relation("DubTeamInviteSender")
  dubVerificationVotes DubVerificationVote[]

  // 11-QISM: Streak, Referral, Quests, Weekly Votes
  referralCode       String?                 @unique
  referredById       String?
  streakCount        Int                     @default(0)
  streakLastActiveAt DateTime?
  streakFreezeCount  Int                     @default(0)
  streakReminders    Boolean                 @default(true)
  referralsReceived  Referral[]              @relation("Referrer")
  referralRecord     Referral?               @relation("Referred")
  userQuests         UserQuest[]
  dailyClaims        UserDailyClaim[]
  weeklyAnimeVotes   WeeklyAnimeVote[]
  clubContributions  ClubQuestContribution[]
}

model Frame {
  id              String      @id
  type            String
  slug            String      @unique
  name            String
  imageUrl        String?     @map("image_url")
  imageWidth      Int?        @map("image_width")
  imageHeight     Int?        @map("image_height")
  version         Int         @default(1)
  rarity          String
  priceCredits    Int?        @map("price_credits")
  acquisition     String
  missionKey      String?     @map("mission_key")
  scale           Decimal     @default(1.3) @db.Decimal(5, 2)
  textInsetLeft   Decimal?    @map("text_inset_left") @db.Decimal(5, 2)
  textInsetRight  Decimal?    @map("text_inset_right") @db.Decimal(5, 2)
  textInsetTop    Decimal?    @map("text_inset_top") @db.Decimal(5, 2)
  textInsetBottom Decimal?    @map("text_inset_bottom") @db.Decimal(5, 2)
  textAlign       String      @default("center") @map("text_align")
  maxFontPx       Int         @default(16) @map("max_font_px")
  minFontPx       Int         @default(11) @map("min_font_px")
  textColor       String?     @map("text_color")
  isActive        Boolean     @default(true) @map("is_active")
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  owners          UserFrame[]
  avatarUsers     User[]      @relation("EquippedAvatarFrame")
  nameUsers       User[]      @relation("EquippedNameFrame")

  @@index([type, isActive, sortOrder])
  @@map("frames")
}

model UserFrame {
  userId     String   @map("user_id")
  frameId    String   @map("frame_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  source     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frame      Frame    @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@id([userId, frameId])
  @@index([frameId])
  @@map("user_frames")
}

model PlatformConfig {
  key   String @id
  value String
}

model CreditPackage {
  id         String  @id
  name       String
  credits    Int
  starsPrice Int // legacy Telegram Stars price, kept for historical rows
  priceDa    Int     @default(0) @map("price_da") // price in DonationAlerts currency units
  bonus      Int     @default(0)
  popular    Boolean @default(false)
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  donationIntents DonationIntent[]
}

model StarsPayment {
  id                      String   @id @default(cuid())
  userId                  String
  kind                    String // CREDITS | ANIME
  packageId               String?
  animeId                 String?
  starsAmount             Int
  creditsGranted          Int      @default(0)
  status                  String   @default("PENDING") // PENDING | PAID | REFUNDED | FAILED
  telegramChargeId        String?  @unique
  providerPaymentChargeId String?
  invoicePayload          String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("star_payments")
}

/// Encrypted OAuth credentials for the platform's DonationAlerts account.
/// Tokens are sealed with AES-256-GCM (DONATIONALERTS_TOKEN_KEY).
model DonationAlertsAuth {
  id              String   @id @default("primary")
  daUserId        String   @map("da_user_id")
  daUserName      String?  @map("da_user_name")
  accessToken     String   @map("access_token")
  refreshToken    String   @map("refresh_token")
  accessExpiresAt DateTime @map("access_expires_at")
  connectedById   String?  @map("connected_by_id")
  connectedAt     DateTime @default(now()) @map("connected_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("donation_alerts_auth")
}

/// One top-up attempt. The user sends exactly amountMinor in the DA currency
/// with the code in the donation message; the code is single-use.
model DonationIntent {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  packageId      String    @map("package_id")
  code           String    @unique
  amountMinor    Int       @map("amount_minor")
  credits        Int
  status         String    @default("pending") // pending | completed | expired | cancelled
  donationId     String?   @unique @map("donation_id")
  donatedMinor   Int?      @map("donated_minor")
  creditsGranted Int?      @map("credits_granted")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  completedAt    DateTime? @map("completed_at")
  user           User      @relation("DonationIntentUser", fields: [userId], references: [id], onDelete: Cascade)
  package        CreditPackage @relation(fields: [packageId], references: [id])
  event          DonationEvent?

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@map("donation_intents")
}

/// Every donation seen by the listener or the sync job, including unmatched
/// ones (kept for admin review). donationId is the DA id and the idempotency key.
model DonationEvent {
  donationId  String   @id @map("donation_id")
  amountMinor Int      @map("amount_minor")
  currency    String
  message     String?
  donorName   String?  @map("donor_name")
  intentId    String?  @unique @map("intent_id")
  status      String   @default("processed") // processed | unmatched | expired | ignored | wrong_currency
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")
  receivedAt  DateTime @default(now()) @map("received_at")
  intent      DonationIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@map("donation_events")
}

/// Creator cash-out request. Credits are held (debited) immediately; a rejection
/// refunds them. Payout details (card/phone) are sealed at rest.
model PayoutRequest {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  credits       Int
  amountMinor   Int       @map("amount_minor")
  currency      String    @default("RUB")
  localCurrency String    @default("RUB") @map("local_currency")
  localAmountMinor Int    @default(0) @map("local_amount_minor")
  method        String // uzcard | humo | payme | click | kaspi | halyk | freedom | odengi | mbank | elsom | optima | bank | other
  details       String // sealed JSON
  status        String    @default("pending") // pending | paid | rejected | cancelled
  adminNote     String?   @map("admin_note")
  processedById String?   @map("processed_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  user          User      @relation("PayoutUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy   User?     @relation("PayoutAdmin", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@map("payout_requests")
}

model Gift {
  id                String        @id @default(cuid())
  senderId          String
  recipientId       String?
  recipientUsername String
  animeId           String
  versionId         String?
  pricePaid         Int
  status            String        @default("PENDING") // PENDING | CLAIMED | DECLINED | EXPIRED | REFUNDED
  message           String?
  idempotencyKey    String        @unique
  expiresAt         DateTime
  claimedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sender            User          @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient         User?         @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  anime             Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  version           AnimeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([recipientId, status])
  @@index([senderId, createdAt])
  @@index([expiresAt, status])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  amount    Int
  refType   String?
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

model Achievement {
  id            String            @id
  emoji         String
  name          String
  description   String
  rarity        String
  category      String
  conditionJson String
  rewardJson    String            @default("{}")
  secret        Boolean           @default(false)
  seasonal      Boolean           @default(false)
  active        Boolean           @default(true)
  sortOrder     Int               @default(0)
  users         UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  target        Int         @default(1)
  unlockedAt    DateTime?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  dataJson  String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
}

model PostBookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followedId String
  createdAt  DateTime @default(now())
  follower   User     @relation("FollowSource", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("FollowTarget", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followedId, createdAt])
  @@index([followerId, createdAt])
}

model PostAward {
  id             String   @id @default(cuid())
  userId         String
  postId         String
  cost           Int
  authorShare    Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String // POST | ANIME | USER | COMMENT
  targetId   String
  reason     String
  status     String   @default("OPEN") // OPEN | HIDDEN | DISMISSED
  createdAt  DateTime @default(now())
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model ScheduleSubscription {
  id        String   @id @default(cuid())
  userId    String
  anilistId Int
  title     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@index([anilistId])
}

model ScheduleDelivery {
  id         String    @id @default(cuid())
  userId     String
  scheduleId Int
  animeTitle String
  episode    Int
  airingAt   DateTime
  status     String    @default("PENDING") // PENDING | SENDING | SENT
  lockedAt   DateTime?
  sentAt     DateTime?
  attempts   Int       @default(0)
  lastError  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduleId])
  @@index([status, lockedAt])
  @@index([airingAt])
}

model DubWaitlist {
  id        String   @id @default(cuid())
  userId    String
  email     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model WatchParty {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  hostId       String
  createdById  String?
  animeId      String
  episodeId    String
  videoUrl     String              @default("")
  isPlaying    Boolean             @default(false)
  position     Float               @default(0)
  serverTs     BigInt              @default(0)
  playbackRate Float               @default(1)
  capacity     Int                 @default(50)
  expiresAt    DateTime
  endedAt      DateTime?
  createdAt    DateTime            @default(now())
  host         User                @relation("PartyHost", fields: [hostId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("PartyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  anime        Anime               @relation(fields: [animeId], references: [id], onDelete: Cascade)
  members      WatchPartyMember[]
  messages     WatchPartyMessage[]

  @@index([endedAt, expiresAt])
  @@index([createdById])
}

model WatchPartyMember {
  id         String     @id @default(cuid())
  partyId    String
  userId     String
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime?
  party      WatchParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([partyId, lastSeenAt])
  @@index([userId, joinedAt])
}

model WatchPartyMessage {
  id        String     @id @default(cuid())
  partyId   String
  userId    String
  body      String
  createdAt DateTime   @default(now())
  party     WatchParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partyId, createdAt])
}

model AnimeSet {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  bonusCredits Int            @default(0)
  items        AnimeSetItem[]
}

model AnimeSetItem {
  id      String   @id @default(cuid())
  setId   String
  animeId String
  set     AnimeSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  anime   Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([setId, animeId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One-time site↔bot account link. Deep link: t.me/<bot>?start=link_<token>
model TelegramLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("telegram_link_tokens")
}

model Anime {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  altTitle         String?
  description      String
  coverImage       String
  bannerImage      String?
  genres           String // comma separated: "Action,Fantasy"
  year             Int
  rating           Float     @default(8.0)
  studio           String?
  status           String    @default("COMPLETED") // ONGOING | COMPLETED | UPCOMING
  type             String    @default("TV") // TV | MOVIE | OVA
  isFree           Boolean   @default(false)
  price            Int       @default(0) // in credits
  trending         Int       @default(0) // sort weight
  featured         Boolean   @default(false)
  airDay           Int? // 0=Sun..6=Sat broadcast day (schedule)
  airTime          String? // "18:30" local airing time (schedule)
  releaseDate      DateTime? // planned release date for upcoming animes
  creatorId        String?
  creator          User?     @relation("AnimeCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  dubTeamId        String?
  dubTeam          DubTeam?  @relation("AnimeDubTeam", fields: [dubTeamId], references: [id], onDelete: SetNull)
  canonicalId      String?
  canonical        Anime?    @relation("AnimeVersions", fields: [canonicalId], references: [id], onDelete: SetNull)
  source           String    @default("OFFICIAL") // OFFICIAL | CREATOR
  moderationStatus String    @default("APPROVED") // PENDING | APPROVED | REJECTED | TAKEDOWN
  hidden           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  episodes             Episode[]
  purchases            Purchase[]
  favorites            FavoriteAnime[]
  progress             WatchProgress[]
  exchangeOffers       ExchangeOffer[]
  postAnimes           Post[]
  proposalAnimes       ExchangeProposal[]
  dubJobs              DubJob[]
  notifyList           AnimeNotify[]
  gifts                Gift[]
  watchParties         WatchParty[]
  setItems             AnimeSetItem[]
  ratings              AnimeRating[]
  dubCredits           DubCredit[]
  dubVerificationVotes DubVerificationVote[]
  watchEvents          WatchEvent[]
  versions             Anime[]                @relation("AnimeVersions")
  catalogVersions      AnimeVersion[]
  weeklyCandidates     WeeklyAnimeCandidate[]
  weeklyVotes          WeeklyAnimeVote[]

  @@index([moderationStatus, hidden, createdAt])
  @@index([canonicalId])
  @@index([creatorId])
  @@index([dubTeamId])
}

/// Official yoki creator tarqatmasi. Narx va egalik shu qatorda.
model AnimeVersion {
  id         String      @id @default(cuid())
  animeId    String
  kind       String      @default("official") // official | creator
  creatorId  String?
  price      Int         @default(0)
  status     String      @default("published") // draft | pending | published | rejected | takedown
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  anime      Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  creator    User?       @relation("VersionCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  episodes   Episode[]
  purchases  Purchase[]
  gifts      Gift[]
  dubCredits DubCredit[]

  @@index([animeId, kind])
  @@map("anime_versions")
}

model Episode {
  id                String        @id @default(cuid())
  animeId           String
  versionId         String?
  number            Int
  title             String
  description       String?
  videoUrl          String
  duration          Int           @default(0) // seconds
  telegramFileId    String?
  telegramMessageId String?
  streamId          String?
  hlsKey            String?
  createdAt         DateTime      @default(now())
  anime             Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  version           AnimeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  progress    WatchProgress[]
  watchEvents WatchEvent[]
  dubJobs     DubJob[]

  @@unique([versionId, number])
  @@index([versionId, number])
}

model Purchase {
  id            String        @id @default(cuid())
  userId        String
  animeId       String
  versionId     String?
  episodeNumber Int           @default(0) // 0 = entire version, 1..N = specific episode
  pricePaid     Int           @default(0)
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime         Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  version       AnimeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@unique([userId, versionId, episodeNumber])
  @@index([userId, versionId])
  @@index([userId, animeId])
}

model FavoriteAnime {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model FavoriteUser {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Favoriter", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Favorited", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  animeId   String
  position  Float    @default(0)
  duration  Float    @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model WatchEvent {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  animeId   String
  seconds   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([animeId, createdAt])
  @@map("watch_events")
}

model AnimeRating {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([animeId, rating])
  @@index([userId, createdAt])
  @@map("anime_ratings")
}

/// Kredit ledger. Balans User.credits da saqlanadi va SUM(amount) ga mos kelishi kerak.
model CreditTransaction {
  id             String   @id @default(cuid())
  userId         String
  amount         Int // positive = gain, negative = spend
  type           String // TOPUP | PURCHASE | EXCHANGE | BONUS | GIFT | AWARD | REFUND | STARS
  description    String
  refType        String?
  refId          String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String
  animeId   String?
  imageUrl  String?
  category  String   @default("Discussions")
  rating    Int?
  spoiler   Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime?   @relation(fields: [animeId], references: [id], onDelete: SetNull)

  likes     PostLike[]
  comments  Comment[]
  bookmarks PostBookmark[]
  awards    PostAward[]

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
}

model Comment {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  parentId  String?
  content   String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model ExchangeOffer {
  id         String             @id @default(cuid())
  userId     String
  animeId    String
  wantedNote String? // what they want in return
  status     String             @default("OPEN") // OPEN | MATCHED | CLOSED | ARCHIVED
  archived   Boolean            @default(true) // 4-qism: Exchange archived, not deleted
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime      Anime              @relation(fields: [animeId], references: [id], onDelete: Cascade)
  proposals  ExchangeProposal[]
}

model ExchangeProposal {
  id         String        @id @default(cuid())
  offerId    String
  proposerId String
  animeId    String // anime the proposer gives
  message    String?
  status     String        @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt  DateTime      @default(now())
  offer      ExchangeOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  proposer   User          @relation("Proposer", fields: [proposerId], references: [id], onDelete: Cascade)
  anime      Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
}

// ---- AI Dubbing (Japanese -> Uzbek / Kazakh / Kirgiz) ----
model DubJob {
  id         String   @id @default(cuid())
  userId     String
  animeId    String
  episodeId  String
  targetLang String // uz | kk | ky
  voice      String // voice profile id
  status     String   @default("COMPLETED") // QUEUED | PROCESSING | COMPLETED | FAILED
  pricePaid  Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime      Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId, targetLang])
}

// ---- Dub jamoalari, cast va obro' ----
model DubTeam {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  ownerId     String?
  reputation  Int      @default(0) // 0..100, dub reytinglari + faollikdan hisoblanadi
  verified    Boolean  @default(false)
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clubId String? @unique

  owner             User?                 @relation("DubTeamOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  club              Club?                 @relation("DubTeamClub", fields: [clubId], references: [id], onDelete: SetNull)
  members           DubTeamMember[]
  credits           DubCredit[]
  ratings           DubTeamRating[]
  animes            Anime[]               @relation("AnimeDubTeam")
  invites           DubTeamInvite[]
  verificationVotes DubVerificationVote[]

  @@index([ownerId])
  @@index([reputation])
  @@map("dub_teams")
}

model DubTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  name      String
  role      String   @default("voice") // voice | director | sound
  createdAt DateTime @default(now())

  team      DubTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User?           @relation("DubTeamMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  castRoles DubCastMember[]

  @@unique([teamId, name])
  @@index([userId])
  @@map("dub_team_members")
}

model DubCredit {
  id           String   @id @default(cuid())
  teamId       String
  animeId      String
  versionId    String?
  language     String   @default("uz") // uz | kk | ky | ru
  speakerCount Int      @default(0)
  createdAt    DateTime @default(now())

  team              DubTeam               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  anime             Anime                 @relation(fields: [animeId], references: [id], onDelete: Cascade)
  version           AnimeVersion?         @relation(fields: [versionId], references: [id], onDelete: SetNull)
  cast              DubCastMember[]
  ratings           DubTeamRating[]
  verificationVotes DubVerificationVote[]

  @@unique([teamId, animeId, language])
  @@index([animeId])
  @@map("dub_credits")
}

model DubCastMember {
  id          String   @id @default(cuid())
  creditId    String
  memberId    String?
  speakerName String
  character   String
  createdAt   DateTime @default(now())

  credit DubCredit      @relation(fields: [creditId], references: [id], onDelete: Cascade)
  member DubTeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([creditId])
  @@map("dub_cast_members")
}

model DubTeamRating {
  id        String   @id @default(cuid())
  teamId    String
  creditId  String
  userId    String
  rating    Int // 1..10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   DubTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  credit DubCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  user   User      @relation("DubTeamRatingUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creditId])
  @@index([teamId])
  @@map("dub_team_ratings")
}

model DubTeamInvite {
  id          String    @id @default(cuid())
  teamId      String
  userId      String
  invitedById String
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  team      DubTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User    @relation("DubTeamInviteUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("DubTeamInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@map("dub_team_invites")
}

/// Bot orqali berilgan "N ta ovoz bor" tasdiqlash javobi.
model DubVerificationVote {
  id           String   @id @default(cuid())
  creditId     String
  teamId       String
  animeId      String
  userId       String
  speakerCount Int
  agrees       Boolean
  createdAt    DateTime @default(now())

  credit DubCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  team   DubTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  anime  Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creditId])
  @@index([creditId])
  @@map("dub_verification_votes")
}

// ---- Telegram Bot Purchases ----
model Order {
  id             String    @id @default(cuid())
  site_user_id   String
  anime_slug     String
  amount         Int
  status         String    @default("PENDING") // PENDING, PAID_PENDING_GRANT, COMPLETED, REFUNDED, FAILED
  provider_tx_id String?   @unique
  provider       String // "stars" (Telegram Stars)
  retryCount     Int       @default(0)
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [site_user_id], references: [id], onDelete: Cascade)
}

// "Tez kunda" — eslatma obunasi
model AnimeNotify {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  notified  Boolean  @default(false) // true = Telegram xabar yuborildi
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

// ─────────────────────────────────────────
// 10-QISM: Klublar
// ─────────────────────────────────────────

model Club {
  id          String   @id @default(cuid())
  name        String
  tag         String   @unique // 2-4 belgi, noyob [TAG]
  description String?
  avatarUrl   String?
  bannerUrl   String?
  isPublic    Boolean  @default(true)
  level       Int      @default(1) // 1-20
  xp          Int      @default(0)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User              @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ClubMember[]
  invites      ClubInvite[]
  joinRequests ClubJoinRequest[]
  xpEvents     ClubXpEvent[]
  chatRoom     ChatRoom?         @relation("ClubRoom")
  quests       ClubQuest[]
  dubTeam      DubTeam?          @relation("DubTeamClub")

  @@index([ownerId])
  @@index([xp])
}

model ClubMember {
  id         String    @id @default(cuid())
  clubId     String
  userId     String
  role       String    @default("member") // owner | mod | member
  mutedUntil DateTime?
  joinedAt   DateTime  @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model ClubInvite {
  id        String    @id @default(cuid())
  clubId    String
  code      String    @unique
  createdBy String
  maxUses   Int       @default(10)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model ClubJoinRequest {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  message   String?
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model ClubXpEvent {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  type      String // message | purchase | watch | daily
  xp        Int
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

// ─────────────────────────────────────────
// 10-QISM: Chat xonalari va xabarlar
// ─────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(cuid())
  type      String // global | club | anime
  refId     String? // clubId yoki animeId
  slowMode  Int      @default(0) // soniyalar, 0 = o'chiq
  createdAt DateTime @default(now())

  clubId String? @unique
  club   Club?   @relation("ClubRoom", fields: [clubId], references: [id], onDelete: Cascade)

  messages ChatMessage[]
  bans     ChatBan[]
  pins     PinnedMessage[]

  @@unique([type, refId])
  @@index([type])
}

model ChatMessage {
  id            String    @id @default(cuid())
  roomId        String
  userId        String
  body          String // sanitized matn yoki JSON (poll, anime_card)
  type          String    @default("text") // text | anime_card | poll | system
  replyToId     String?
  animeId       String? // anime karta uchun
  episodeNo     Int? // spoiler tegi
  attachmentUrl String? // R2 rasm
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  room      ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo   ChatMessage?      @relation("MessageReply", fields: [replyToId], references: [id])
  replies   ChatMessage[]     @relation("MessageReply")
  reactions MessageReaction[]
  poll      Poll?
  pins      PinnedMessage[]

  @@index([roomId, createdAt])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emote     String // emoji yoki custom emote kodi
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emote])
  @@index([messageId])
}

model Poll {
  id        String    @id @default(cuid())
  messageId String    @unique
  question  String
  options   String // JSON array: ["A", "B", "C"]
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  votes   PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionIdx Int
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model PinnedMessage {
  id        String   @id @default(cuid())
  roomId    String
  messageId String
  pinnedBy  String
  createdAt DateTime @default(now())

  room    ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([roomId, messageId])
}

model ChatBan {
  id        String    @id @default(cuid())
  roomId    String? // null = global ban
  userId    String
  bannedBy  String
  reason    String?
  type      String    @default("ban") // ban | mute
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  room ChatRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, userId])
  @@index([userId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// ─────────────────────────────────────────
// 10-QISM: Emotelar va level gate
// ─────────────────────────────────────────

model Emote {
  id          String  @id @default(cuid())
  code        String  @unique // :kiluu_fire: kabi
  imageUrl    String
  unlockType  String  @default("free") // free | level | achievement | purchase
  unlockValue String? // level raqami yoki achievement id

  userEmotes UserEmote[]
}

model UserEmote {
  id         String   @id @default(cuid())
  userId     String
  emoteId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emote Emote @relation(fields: [emoteId], references: [id], onDelete: Cascade)

  @@unique([userId, emoteId])
}

model LevelGate {
  id       String @id @default(cuid())
  feature  String @unique // create_club | send_image | create_poll | ...
  minLevel Int    @default(1)
}

// ─────────────────────────────────────────
// 11-QISM: Quests, Streak, Referral, Events, Weekly Votes
// ─────────────────────────────────────────

model LevelReward {
  id          String   @id @default(cuid())
  level       Int      @unique
  title       String
  rewardType  String // frame | banner | emote | credits | streak_freeze | title
  rewardValue String
  description String?
  createdAt   DateTime @default(now())
}

model DailyXpCap {
  id     String @id @default(cuid())
  userId String
  date   String // YYYY-MM-DD
  source String // post | comment | like | chat
  amount Int    @default(0)

  @@unique([userId, date, source])
  @@index([userId, date])
}

model UserDailyClaim {
  id         String   @id @default(cuid())
  userId     String
  claimDate  String // YYYY-MM-DD
  streakDay  Int
  xpAwarded  Int      @default(0)
  rewardJson String   @default("{}")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, claimDate])
  @@index([userId])
}

model QuestTemplate {
  id             String         @id @default(cuid())
  title          String
  titleUz        String
  description    String?
  type           String // daily | weekly | club | event
  category       String         @default("general") // watch | social | explore | spend
  eventType      String // episode_watched | post_created | comment_created | like_received | chat_message_sent | gift_sent | anime_opened | club_message | daily_claim | ...
  targetCount    Int            @default(1)
  xpReward       Int            @default(20)
  creditReward   Int            @default(0)
  cosmeticReward String?
  difficulty     String         @default("easy") // easy | medium | hard
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  eventId        String?
  event          SeasonalEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  userQuests UserQuest[]

  @@index([type, isActive])
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  templateId  String
  periodKey   String // e.g. "daily:2026-10-23", "weekly:2026-W43", "event:halloween-2026"
  progress    Int       @default(0)
  targetCount Int
  status      String    @default("active") // active | completed | claimed
  claimedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template QuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId, periodKey])
  @@index([userId, status])
  @@index([periodKey])
}

model ClubQuest {
  id             String   @id @default(cuid())
  clubId         String
  title          String
  eventType      String
  targetCount    Int
  progress       Int      @default(0)
  status         String   @default("active") // active | completed
  periodKey      String
  xpRewardClub   Int      @default(100)
  xpRewardMember Int      @default(50)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  club          Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  contributions ClubQuestContribution[]

  @@unique([clubId, periodKey, eventType])
  @@index([clubId])
}

model ClubQuestContribution {
  id          String  @id @default(cuid())
  clubQuestId String
  userId      String
  amount      Int     @default(0)
  claimed     Boolean @default(false)

  quest ClubQuest @relation(fields: [clubQuestId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubQuestId, userId])
}

model Referral {
  id           String    @id @default(cuid())
  referrerId   String
  referredId   String    @unique
  code         String
  status       String    @default("pending") // pending | qualified | rewarded | declined
  isSuspicious Boolean   @default(false)
  qualifiedAt  DateTime?
  rewardedAt   DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
}

model WeeklyAnimePoll {
  id            String   @id @default(cuid())
  weekKey       String   @unique // e.g. "2026-W43"
  status        String   @default("active") // active | closed
  winnerAnimeId String?
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime @default(now())

  candidates WeeklyAnimeCandidate[]
  votes      WeeklyAnimeVote[]
}

model WeeklyAnimeCandidate {
  id         String  @id @default(cuid())
  pollId     String
  animeId    String
  votesCount Int     @default(0) // Poll tugaguncha sir saqlanadi
  isManual   Boolean @default(false)

  poll  WeeklyAnimePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  anime Anime           @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([pollId, animeId])
}

model WeeklyAnimeVote {
  id            String   @id @default(cuid())
  pollId        String
  animeId       String
  userId        String
  rewardClaimed Boolean  @default(false)
  createdAt     DateTime @default(now())

  poll  WeeklyAnimePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  anime Anime           @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model SeasonalEvent {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  titleUz        String
  description    String?
  themeColor     String   @default("#f97316")
  bannerUrl      String?
  startsAt       DateTime
  endsAt         DateTime
  isNeverReturns Boolean  @default(true)
  configJson     String   @default("{}")
  createdAt      DateTime @default(now())

  quests QuestTemplate[]
}
