# Neon PostgreSQL (web + Watch Together shared source of truth).
# Use Neon’s pooled URL at runtime; migrations require the direct URL below.
DATABASE_URL="REDACTED_DATABASE_URL"
DIRECT_URL="REDACTED_DIRECT_URL"

# Session / app
NEXTAUTH_URL="http://localhost:3000"

# Telegram Login Widget + Mini App HMAC. This is the BOT TOKEN.
# Never reuse it as ANIME_BOT_API_KEY.
TELEGRAM_BOT_TOKEN=""
BOT_TOKEN=""

# Site ↔ bot HTTP (shared secret, NOT the bot token)
ANIME_BOT_API_KEY=""
ANIME_BOT_API_URL="http://localhost:8000"
BOT_DATABASE_URL=""
ANIME_BOT_USERNAME="DubAniXbot"
NEXT_PUBLIC_BOT_USERNAME="DubAniXbot"
SITE_API_KEY=""

# Optional Stars webhook extra secret
TELEGRAM_STARS_WEBHOOK_SECRET=""
CRON_SECRET=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0"

# Admins (comma-separated). Bot Admin UI is role=admin OR these IDs.
ADMIN_USER_IDS=""
ADMIN_TELEGRAM_IDS=""

# Economy
CREATOR_SHARE_PERCENT="70"
PLATFORM_SHARE_PERCENT="30"
GIFT_EXPIRY_DAYS="14"
DEFAULT_LOCALE="uz"

# Cloudflare R2 object storage for images.
# Create an R2 bucket and an S3 API token scoped to that bucket.
# Bind the bucket privately to cloudflare/r2-media-worker.mjs; point this at the Worker custom domain.
R2_ACCOUNT_ID="818c96a2ffd0b415d0d7de4f6289c090"
R2_ACCESS_KEY_ID="REDACTED_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REDACTED_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="kiluu"
R2_PUBLIC_BASE_URL="REDACTED_R2_PUBLIC_BASE_URL"
R2_HLS_SIGNING_SECRET=""

# Optional legacy Cloudflare Stream playback for episodes uploaded before R2 HLS.
CF_STREAM_ACCOUNT_ID="818c96a2ffd0b415d0d7de4f6289c090"
CF_STREAM_API_TOKEN="REDACTED_CF_STREAM_API_TOKEN"
CF_STREAM_CUSTOMER_SUBDOMAIN="videodelivery.net"

# Watch Together service; use the same DATABASE_URL as the web app.
WATCH_PARTY_SECRET=""
WATCH_PARTY_PORT="3003"
WATCH_PARTY_ALLOWED_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_WATCH_PARTY_URL="http://localhost:3003"
PUBLIC_APP_ORIGIN="http://localhost:3000"
# Each participant (including the host) spends this many credits to enter a party.
WATCH_PARTY_JOIN_PRICE_CREDITS="5"
# Set REDIS_URL when running more than one Watch Together service instance.
REDIS_URL=""

# Stars test: BotFather /mybots → Payments → Test. Invoices use currency XTR, empty provider_token.
